TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Kotak Neo Trade API (Neo app > More > Trade API). Anyone who can read this file can use the account:
# keep .env private and never share or commit it.
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE=              # registered mobile with country code, e.g. +919876543210
KOTAK_UCC=                 # client code (Neo app > Profile)
# Optional. With both, the app logs in by itself (and again when the session lapses). Leave KOTAK_TOTP_SECRET
# empty to log in on the dashboard each day with the 6-digit code from your authenticator app.
KOTAK_MPIN=
KOTAK_TOTP_SECRET=         # base32 key shown when registering TOTP (the text behind the QR code)

PORT=8060                  # dashboard at http://127.0.0.1:8060
DASHBOARD_PIN=             # other devices log in with it (6+ digits); empty = only this PC

CAPITAL=100000             # with RISK_PER_TRADE_PCT: the risk budget behind the lots shown
RISK_PER_TRADE_PCT=1.0
NR7_AUTO_INDICES=NIFTY,BANKNIFTY  # auto-trade: indices traded, as in-the-money monthly options
NR7_AUTO_LOTS=1            # lots per trade (fixed, whatever the setup risks)
NR7_OPTION_MIN_DAYS=14     # the monthly expiry at least this many calendar days away
OPTION_PROTECTION_PCT=5.0  # orders go in as limits this % past the ask / bid (SEBI: no API market orders)
OPTIONS_MAX_SPREAD_PCT=5   # no buy while the option's bid-ask spread is wider than this %
